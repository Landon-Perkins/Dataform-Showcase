config {
    type: "table",
    name: "money_manager",
    schema: "money_manager",
    description: "Generates a main table to support various analytics functions that depend on financial transaction details as well as other tables that support the money manager application.",
    tags: ["money_manager"],
    bigquery: {
        labels: {
            scheduler: "dataform",
            refresh: "hourly",
            author: "Stakeholder"
        },
        partitionBy: "DATE_TRUNC(accounting_date, MONTH)",
        clusterBy: ["entity_id"]
    },
    dependOnDependencyAssertions: true,
    columns: {
        tranlineid: "Identifier for the transaction line.",
        memo: "Memo or note associated with the transaction line.",
        class_id: "Identifier for the class associated with the transaction line.",
        department_id: "Identifier for the department related to the transaction line.",
        department_name: "Name of the department.",
        entity_id: "Identifier for the entity or record.",
        subsidiary_id: "Identifier for the subsidiary or branch.",
        vendor_id: "Identifier for the vendor.",
        sku: "Stock Keeping Unit (SKU) associated with the transaction.",
        rate: "Rate or price associated with the transaction.",
        quantity: "Quantity involved in the transaction.",
        custcol_attban: "Custom column or attribute related to the transaction.",
        subsidiary_name: "Name of the subsidiary or branch.",
        posting: "Posting or recording status of the transaction.",
        document_number: "Document or reference number for the transaction.",
        transaction_status_full_name: "Full name or description of the transaction status.",
        transaction_status_name: "Name or label of the transaction status.",
        transaction_date: "Date of the transaction.",
        main_memo: "Main memo or note associated with the transaction.",
        cashback_rep: "Identifier or name of the cashback representative.",
        cashback_notes: "Notes or additional information about cashback.",
        rebate_name: "Name or type of rebate associated with the transaction.",
        rebate_type_name: "Name or label for the type of rebate.",
        transaction_type: "Type or category of the transaction.",
        createdby: "Identifier or name of the user who created the transaction.",
        journal_displayname: "Display name or label for the journal entry.",
        deposit_displayname: "Display name or label for the deposit entry.",
        journal_item_fullname: "Full name or identifier of the journal item.",
        deposit_item_fullname: "Full name or identifier of the deposit item.",
        transactionline_item_fullname: "Full name or identifier of the transaction line item.",
        transactionline_item_display_name: "Display name or label for the transaction line item.",
        accounting_period_name: "Name of the accounting period.",
        accounting_date: "End date of the accounting period.",
        account_name: "Name of the account involved in the transaction.",
        account_type: "Type of the account (e.g., expense, revenue).",
        account_number: "Account number or code.",
        alt_account_number: "Alternative account number or code.",
        customer_entity_id: "Identifier for the customer entity.",
        customer_netsuite_internal_id: "demo_platform internal identifier for the customer.",
        demo_id: "Unique identifier for the member or entity.",
        vendor_entity: "Identifier for the vendor entity.",
        vendor_entity_number: "Vendor entity number or code.",
        lrs_customer_type: "Type or classification of the customer.",
        entity_name: "Name of the entity or member.",
        class: "Class or category associated with the transaction.",
        vendor_name: "Name of the vendor.",
        secondary_vendor_name: "Name of the secondary vendor.",
        ref: "Reference number or identifier.",
        client_account_number: "Client account number or identifier.",
        event_name: "Name or type of the event associated with the transaction.",
        annual_show_show: "Name or label of the annual_show show.",
        annual_show_show_id: "ID of annual_show show",
        vendor_category: "Category or type of the vendor.",
        secondary_vendor_entity_id: "Identifier for the secondary vendor entity.",
        secondary_vendor_integer_id: "Integer identifier for the secondary vendor.",
        secondary_member_customer_id: "When an entity id is stated on a transaction but if there's a secondary_member_customer_id listed as well, that means it's on behalf of that secondary_member etc",
        tranline_created_from: "Information about the creation source of the transaction line.",
        po_number: "Purchase order number associated with the transaction.",
        tranline_line_last_modified_date: "Last modified date of the transaction line.",
        transaction_last_modified_date: "Last modified date of the transaction.",
        linked_member_demo_id: "demo ID of the linked member.",
        amount: "Amount involved in the transaction.",
        netsuite_amount: "Amount in demo_platform for the transaction.",
        unpaid_amount: "Unpaid amount associated with the transaction.",
        money_manager_entity_id: "Identifier for the entity related to money management.",
        transaction_entity_id: "Identifier for the entity associated with the transaction.",
        billing_period_name: "Name of the billing period.",
        billing_period: "Parsed and normalized end date of the billing period, derived from billing_period_name.",
        industry_name: "Name of the industry associated with the transaction; sourced from industries.name.",
        line_created_date: "Timestamp when the transaction line was created; sourced from transaction_lines.linecreateddate.",
        transaction_created_date: "	Date part of the transaction creation timestamp; sourced from transactions.createddate."
    },
    assertions: {
        uniqueKeys: [
            ["transaction", "tranlineid"]
        ]
    }
}

SELECT
  *
FROM ${ref("money_manager", "money_manager_driver")}